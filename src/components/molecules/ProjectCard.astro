---
interface Props {
  title: string;
  description: string;
  stack: string[];
  status?: "completed" | "in-progress";
  href?: string;
  source?: string;
}

const { title, description, stack, status = "completed", href, source } = Astro.props;
---

<article
  class:list={[
    "group relative p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 transition-all duration-300",
    href && "hover:border-zinc-300 dark:hover:border-zinc-700 hover:bg-zinc-50/50 dark:hover:bg-zinc-900/40",
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <div class="flex items-center gap-2">
      <h3
        class="text-base font-semibold tracking-tight text-zinc-900 dark:text-white"
        class:list={[href && "group-hover:text-zinc-900 dark:group-hover:text-white transition-colors duration-200"]}
      >
        {title}
      </h3>
      {href && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="w-3.5 h-3.5 text-zinc-300 dark:text-zinc-700 group-hover:text-zinc-900 dark:group-hover:text-white transition-colors duration-200"
          aria-hidden="true"
        >
          <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Zm6.75-3a.75.75 0 0 1 .75-.75h4.5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0V3.56l-3.97 3.97a.75.75 0 0 1-1.06-1.06l3.97-3.97H11a.75.75 0 0 1-.75-.75Z" clip-rule="evenodd" />
        </svg>
      )}
      {source && (
        <a
          href={source}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View ${title} source on GitHub`}
          class="text-zinc-300 dark:text-zinc-700 hover:text-zinc-900 dark:hover:text-white transition-colors duration-200"
        >
          <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="currentColor" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
          </svg>
        </a>
      )}
    </div>
    {
      status === "in-progress" && (
        <span class="shrink-0 inline-flex items-center gap-1.5 text-xs font-medium text-zinc-400 dark:text-zinc-600">
          <span class="h-1.5 w-1.5 rounded-full bg-zinc-400 dark:bg-zinc-600 animate-pulse"></span>
          in progress
        </span>
      )
    }
  </div>
  <p class="mt-2.5 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">{description}</p>
  <div class="mt-4 flex flex-wrap gap-1.5">
    {stack.map((tech) => (
      <span class="inline-flex items-center rounded-full border border-zinc-200 dark:border-zinc-800 px-2 py-0.5 text-xs text-zinc-500 dark:text-zinc-500">
        {tech}
      </span>
    ))}
  </div>
  {href && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`View ${title} live (opens in new tab)`}
      class="absolute inset-0 rounded-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900 dark:focus-visible:outline-white"
    ></a>
  )}
</article>
