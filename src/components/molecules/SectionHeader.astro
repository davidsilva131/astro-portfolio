---
interface Props {
  label: string;
  title: string;
}

const { label, title } = Astro.props;
---

<div class="mb-14 animate-in">
  <p class="font-mono text-xs uppercase tracking-[0.2em] text-zinc-400 dark:text-zinc-600">
    {label}
  </p>
  <h2 class="mt-3 text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-4xl">
    {title}
  </h2>
</div>
