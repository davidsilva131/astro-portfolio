---
interface Props {
  label?: string;
  title: string;
}

const { label, title } = Astro.props;
---

<div class="mb-14 animate-in">
  {label && (
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400">
      {label}
    </p>
  )}
  <h2
    class:list={[
      "text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-4xl",
      label ? "mt-3" : "",
    ]}
  >
    {title}
  </h2>
</div>
