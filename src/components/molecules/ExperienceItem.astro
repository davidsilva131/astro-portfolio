---
import type { ExperienceMetric } from "../../data/experience";

interface Props {
  period: string;
  role: string;
  title: string;
  description: string;
  stack: string[];
  metrics?: ExperienceMetric[];
}

const { period, role, title, description, stack, metrics } = Astro.props;
---

<div class="relative pl-8 border-l border-zinc-200 dark:border-zinc-800">
  <span class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-zinc-900 dark:bg-white ring-4 ring-white dark:ring-black"></span>
  <p class="font-mono text-xs text-zinc-500 dark:text-zinc-400">{period}</p>
  <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-400">
    {role}
  </p>
  <h3 class="mt-2 text-xl font-semibold tracking-tight text-zinc-900 dark:text-white">{title}</h3>
  <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-xl">{description}</p>
  {metrics && metrics.length > 0 && (
    <div class="mt-5 flex flex-wrap gap-x-8 gap-y-4">
      {metrics.map((metric) => (
        <div class="flex flex-col gap-1">
          <span class="font-mono text-sm text-zinc-900 dark:text-white">{metric.value}</span>
          <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400">{metric.label}</span>
        </div>
      ))}
    </div>
  )}
  <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
    {stack.map((tech) => (
      <span class="font-mono text-xs text-zinc-600 dark:text-zinc-400">{tech}</span>
    ))}
  </div>
</div>