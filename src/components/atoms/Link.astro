---
interface Props {
  href: string;
  download?: string;
  variant?: "primary" | "ghost";
  class?: string;
}

const { href, download, variant = "primary", class: className = "" } = Astro.props;
---

<a
  href={href}
  download={download}
  class:list={[
    "inline-flex items-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium transition-all duration-200 active:translate-y-px focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900 dark:focus-visible:outline-white",
    variant === "primary"
      ? "bg-zinc-900 text-white hover:bg-zinc-700 dark:bg-white dark:text-black dark:hover:bg-zinc-200"
      : "border border-zinc-300/80 text-zinc-700 hover:border-zinc-900 hover:text-zinc-900 dark:border-zinc-700/60 dark:text-zinc-300 dark:hover:border-white dark:hover:text-white",
    className,
  ]}
>
  <slot />
</a>
