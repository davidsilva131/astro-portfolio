---
import { STACK_CATEGORIES } from "../../data/stack";
---

<section
  id="stack"
  aria-label="Tech stack"
  class="max-w-3xl mx-auto px-4 md:px-6 py-28 border-t border-zinc-200/60 dark:border-zinc-900"
>
  <div class="mb-12 animate-in">
    <h2
      class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-4xl"
    >
      Stack
    </h2>
    <p class="mt-3 max-w-xl text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
      The tools I reach for, organised by what they do for me.
    </p>
  </div>

  <ul role="list" class="flex flex-col gap-10">
    {STACK_CATEGORIES.map((cat, i) => (
      <li
        class="grid grid-cols-[auto_1fr] gap-6 sm:gap-10 animate-in"
        style={`transition-delay: ${i * 60}ms`}
      >
        <div class="flex items-baseline gap-4">
          <span class="font-mono text-xs text-zinc-400 dark:text-zinc-600">{cat.index}</span>
          <h3 class="text-sm font-semibold tracking-tight text-zinc-900 dark:text-white whitespace-nowrap">
            {cat.label}
          </h3>
        </div>
        <ul role="list" class="flex flex-wrap gap-x-4 gap-y-2 self-center">
          {cat.items.map((item) => (
            <li class="font-mono text-xs text-zinc-600 dark:text-zinc-400">
              {item}
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</section>
