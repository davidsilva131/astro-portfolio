<section
  id="contact"
  aria-label="Get in Touch"
  class="max-w-3xl mx-auto px-4 md:px-6 py-28 border-t border-zinc-200/60 dark:border-zinc-900"
>
  <div class="animate-in">
    <h2 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-4xl">
      Get in Touch
    </h2>
    <p class="mt-4 max-w-md text-zinc-600 dark:text-zinc-400 leading-relaxed">
      Open to new opportunities. If you have a project in mind or just want to
      connect, my inbox is always open.
    </p>

    <div class="mt-10 flex flex-col gap-6">
      <a
        href="mailto:davidsilvac131@gmail.com"
        class="link-underline w-fit text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white hover:text-zinc-500 dark:hover:text-zinc-400 transition-colors duration-200 [overflow-wrap:anywhere] rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900 dark:focus-visible:outline-white"
      >
        davidsilvac131@gmail.com
      </a>
      <div class="flex items-center gap-6">
        <a
          href="https://github.com/davidsilva131"
          class="link-underline font-mono text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white transition-colors duration-200 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900 dark:focus-visible:outline-white"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
          <span class="sr-only">(opens in new tab)</span>
        </a>
        <a
          href="https://www.linkedin.com/in/juan-david-silva-contreras1/"
          class="link-underline font-mono text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white transition-colors duration-200 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900 dark:focus-visible:outline-white"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </div>
    </div>
  </div>
</section>
