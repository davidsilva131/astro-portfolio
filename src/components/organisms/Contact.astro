<section
  id="contact"
  aria-label="Get in Touch"
  class="max-w-3xl mx-auto px-6 py-28 border-t border-zinc-100 dark:border-zinc-900"
>
  <div class="animate-in">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-zinc-400 dark:text-zinc-600">
      Contact
    </p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-4xl">
      Get in Touch
    </h2>
    <p class="mt-4 max-w-md text-zinc-600 dark:text-zinc-400 leading-relaxed">
      Open to new opportunities. If you have a project in mind or just want to
      connect — my inbox is always open.
    </p>

    <div class="mt-10 flex flex-col gap-5">
      <a
        href="mailto:davidsilvac131@gmail.com"
        class="link-underline font-mono text-sm text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors duration-200 w-fit"
      >
        davidsilvac131@gmail.com
      </a>
      <div class="flex items-center gap-5">
        <a
          href="https://github.com/davidsilva131"
          class="link-underline text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white transition-colors duration-200"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
          <span class="sr-only">(opens in new tab)</span>
        </a>
        <a
          href="https://www.linkedin.com/in/juan-david-silva-contreras1/"
          class="link-underline text-sm text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white transition-colors duration-200"
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
          <span class="sr-only">(opens in new tab)</span>
        </a>
      </div>
    </div>
  </div>
</section>
