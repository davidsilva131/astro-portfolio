---
import SectionHeader from "../molecules/SectionHeader.astro";
import ExperienceItem from "../molecules/ExperienceItem.astro";

const VISIBLE_COUNT = 3;

const experience = [
  {
    period: "2024",
    role: "Frontend Developer",
    title: "Agendamiento / Cancillería",
    description:
      "Platform for scheduling and managing administrative procedures for Colombian foreign ministries. Built the frontend with React, Redux Toolkit and Material UI on a Vite build.",
    stack: ["React", "Redux", "RTK", "Material UI", "Vite"],
  },
  {
    period: "2024",
    role: "Frontend Developer",
    title: "BeMyself",
    description:
      "Platform for managing digital credentials (e-cards) and enabling digital document signing. Implemented the frontend with React, Redux Toolkit and Material UI.",
    stack: ["React", "Redux", "RTK", "Material UI", "Vite"],
  },
  {
    period: "2023 - Present",
    role: "Frontend Developer",
    title: "Guarda",
    description:
      "SICOV system for issuing certificates of legal firearm possession. Contributed to the frontend and led the Webpack-to-Vite migration, improving build performance.",
    stack: ["React", "Redux", "RTK", "Material UI", "Webpack", "Vite"],
  },
  {
    period: "2023 - Present",
    role: "Frontend Developer",
    title: "Aulapp CEAS",
    description:
      "Platform for automotive training centers that issues driving training certificates to students and instructors. Developed the frontend with React, Redux Toolkit and Material UI.",
    stack: ["React", "Redux", "RTK", "Material UI", "Vite"],
  },
  {
    period: "2023 - Present",
    role: "Frontend Developer",
    title: "Aulapp CIAS",
    description:
      "Educational platform where traffic offenders complete mandatory remedial courses. Built the frontend with React, Redux Toolkit and Material UI.",
    stack: ["React", "Redux", "RTK", "Material UI", "Vite"],
  },
];

const visibleItems = experience.slice(0, VISIBLE_COUNT);
const hiddenItems = experience.slice(VISIBLE_COUNT);
const hasMore = hiddenItems.length > 0;
---

<section
  id="experience"
  aria-label="Client work"
  class="max-w-3xl mx-auto px-4 md:px-6 py-28 border-t border-zinc-100 dark:border-zinc-900"
>
  <SectionHeader title="Client Work" />
  <div class="flex flex-col gap-12">
    {visibleItems.map((item, i) => (
      <div class="animate-in" style={`transition-delay: ${i * 80}ms`}>
        <ExperienceItem {...item} />
      </div>
    ))}
    {hasMore && (
      <div id="experience-extra" class="flex flex-col gap-12 hidden">
        {hiddenItems.map((item, i) => (
          <div class="animate-in" style={`transition-delay: ${(VISIBLE_COUNT + i) * 80}ms`}>
            <ExperienceItem {...item} />
          </div>
        ))}
      </div>
    )}
  </div>
  {hasMore && (
    <button
      id="experience-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="experience-extra"
      class="mt-12 flex items-center gap-2 text-sm font-medium text-zinc-500 dark:text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900 dark:focus-visible:outline-white"
    >
      <span id="experience-toggle-label">
        Show {hiddenItems.length} more
      </span>
      <svg
        id="experience-toggle-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-transform duration-200"
        aria-hidden="true"
      >
        <polyline points="6 9 12 15 18 9" />
      </svg>
    </button>
  )}
</section>

<script>
  const btn = document.getElementById("experience-toggle");
  const extra = document.getElementById("experience-extra");
  const label = document.getElementById("experience-toggle-label");
  const icon = document.getElementById("experience-toggle-icon");

  if (btn && extra && label && icon) {
    const hiddenCount = extra.childElementCount;

    btn.addEventListener("click", () => {
      const isExpanded = btn.getAttribute("aria-expanded") === "true";
      extra.classList.toggle("hidden", isExpanded);
      btn.setAttribute("aria-expanded", String(!isExpanded));
      icon.style.transform = isExpanded ? "" : "rotate(180deg)";
      label.textContent = isExpanded ? `Show ${hiddenCount} more` : "Show less";

      if (isExpanded) {
        btn.focus();
      } else {
        const firstItem = extra.querySelector("h3");
        if (firstItem) {
          firstItem.setAttribute("tabindex", "-1");
          firstItem.focus();
        }
      }
    });
  }
</script>
