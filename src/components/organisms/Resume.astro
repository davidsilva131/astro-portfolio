---
import Link from "../atoms/Link.astro";
---

<section
  id="resume"
  aria-label="Download My CV"
  class="max-w-3xl mx-auto px-4 md:px-6 py-28 border-t border-zinc-200/60 dark:border-zinc-900"
>
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 animate-in">
    <div>
      <h2 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-white sm:text-4xl">
        Download My CV
      </h2>
      <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
        Available in English and Spanish.
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <Link href="/cvs/juan-david-silva-cv-en.pdf" download="Juan-David-Silva-CV-EN.pdf">
        Download EN
      </Link>
      <Link href="/cvs/juan-david-silva-cv-es.pdf" download="Juan-David-Silva-CV-ES.pdf" variant="ghost">
        Download ES
      </Link>
    </div>
  </div>
</section>
