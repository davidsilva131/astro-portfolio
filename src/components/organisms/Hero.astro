---
import Link from "../atoms/Link.astro";
import Monogram from "../atoms/Monogram.astro";
---

<section
  id="about"
  aria-label="About Juan David Silva Contreras"
  class="max-w-6xl mx-auto px-6 pt-24 pb-20 md:pt-32 md:pb-28 min-h-[calc(100vh-4rem)] flex items-center"
>
  <div class="grid grid-cols-1 md:grid-cols-[1fr_0.55fr] gap-12 md:gap-16 lg:gap-24 items-center w-full">
    <div class="animate-in order-2 md:order-1">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-zinc-400 dark:text-zinc-600">
        Software Developer
      </p>
      <h1
        class="mt-4 text-[clamp(2.5rem,8vw,5rem)] font-bold leading-[0.92] tracking-tight text-zinc-900 dark:text-white"
      >
        Juan David<br />
        <span class="text-zinc-400 dark:text-zinc-600">Silva Contreras</span>
      </h1>
      <p class="mt-6 max-w-lg text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
        I build fast, accessible and visually refined web interfaces with clean, maintainable code.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Link href="#projects" class="whitespace-nowrap">
          See my work
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M7 17 L17 7" />
            <path d="M7 7 h10 v10" />
          </svg>
        </Link>
        <Link href="#contact" variant="ghost" class="whitespace-nowrap">
          Get in touch
        </Link>
      </div>
    </div>

    <div class="order-1 md:order-2 flex justify-center md:justify-end">
      <Monogram
        class="monogram-parallax w-40 h-40 sm:w-48 sm:h-48 md:w-56 md:h-56 lg:w-64 lg:h-64 text-zinc-300 dark:text-zinc-700"
      />
    </div>
  </div>
</section>
