---
import SectionHeader from "../molecules/SectionHeader.astro";
import ProjectCard from "../molecules/ProjectCard.astro";

const projects = [
  {
    title: "LotoPetsPlay",
    description:
      "Gaming platform themed around pets, featuring user accounts, match history, and real-time data management.",
    stack: ["Next.js", "Tailwind CSS", "Supabase"],
    status: "in-progress" as const,
  },
  {
    title: "VFX Ayverson",
    description:
      "Professional portfolio for a video designer and editor, showcasing a work gallery and personal brand presentation.",
    stack: ["Astro", "Tailwind CSS"],
    status: "completed" as const,
    href: "https://vfx-ayverson.davidsilvac131.workers.dev/",
  },
  {
    title: "Academia Eudalio Arriaga",
    description:
      "Registration page for the football academy of former professional player Eudalio Arriaga.",
    stack: ["Astro", "Tailwind CSS"],
    status: "completed" as const,
    href: "https://academiaeudalioarriaga.com/",
  },
  {
    title: "Revil",
    description:
      "Platform for offering social media followers and engagement services.",
    stack: ["Astro", "Tailwind CSS"],
    status: "completed" as const,
    href: "https://revil.shop/",
  },
  {
    title: "Recipes IA",
    description:
      "AI-powered app that generates recipes based on your ingredients.",
    stack: ["Next.js", "Tailwind CSS", "OpenAI"],
    status: "completed" as const,
    href: "https://recipes-ia.davidsilvac131.workers.dev/",
  },
];
---

<section
  id="projects"
  aria-label="Things I've Built"
  class="max-w-3xl mx-auto px-6 py-28 border-t border-zinc-100 dark:border-zinc-900"
>
  <SectionHeader label="Projects" title="Things I've Built" />
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    {projects.map((project) => <ProjectCard {...project} />)}
  </div>
</section>
