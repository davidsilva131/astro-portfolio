---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/organisms/Nav.astro";
import Footer from "../components/organisms/Footer.astro";
---

<Layout title="404 - Page Not Found | Juan David Silva Contreras">
  <Nav />
  <main id="main-content" class="max-w-3xl mx-auto px-4 md:px-6 py-32 min-h-[calc(100dvh-8rem)]">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-zinc-400 dark:text-zinc-600">
      404
    </p>
    <h1 class="mt-5 text-5xl font-bold tracking-tighter text-zinc-900 dark:text-white sm:text-7xl leading-[0.95]">
      Page Not Found
    </h1>
    <p class="mt-8 max-w-md text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="mt-10 inline-flex items-center gap-2 text-sm font-medium text-zinc-900 dark:text-white link-underline transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-900 dark:focus-visible:outline-white rounded-sm"
    >
      &larr; Back to home
    </a>
  </main>
  <Footer />
</Layout>
