---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/organisms/Nav.astro";
import Footer from "../components/organisms/Footer.astro";
---

<Layout title="404 — Page Not Found | Juan David Silva Contreras">
  <Nav />
  <main id="main-content" class="max-w-3xl mx-auto px-6 py-24">
    <span class="text-xs font-semibold tracking-widest uppercase text-cyan-600 dark:text-cyan-400">
      404
    </span>
    <h1 class="mt-4 text-5xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 leading-tight">
      Page Not Found
    </h1>
    <p class="mt-6 max-w-md text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-cyan-600 hover:text-cyan-700 dark:text-cyan-400 dark:hover:text-cyan-300 transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-500 rounded-sm"
    >
      &larr; Back to home
    </a>
  </main>
  <Footer />
</Layout>
